<idea-plugin>
  <id>io.github.nemf1s.ImportTrimmer</id>
  <name>Import Trimmer</name>
  <vendor>Nemf1s</vendor>
  <description><![CDATA[
    Offers to remove Java imports observed transitioning from used to unused.
    Preserves remaining import order and unrelated text.
  ]]></description>
  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.java</depends>
  <resource-bundle>messages.MyMessageBundle</resource-bundle>
  <extensions defaultExtensionNs="com.intellij">
    <postStartupActivity implementation="io.github.nemf1s.ImportTrimmerStartupActivity"/>
    <notificationGroup id="Import Trimmer suggestions"
                       displayType="BALLOON"
                       isLogByDefault="true"/>
    <projectConfigurable id="io.github.nemf1s.ImportTrimmer.settings"
                         displayName="Import Trimmer"
                         parentId="editor"
                         instance="io.github.nemf1s.settings.ImportTrimmerConfigurable"/>
  </extensions>
  <actions>
    <action id="ImportTrimmer.Review"
            class="io.github.nemf1s.actions.ReviewNewlyUnusedImportsAction"
            text="Review newly unused Java imports"
            description="Review historically used Java imports that are now unused"/>
  </actions>
</idea-plugin>
